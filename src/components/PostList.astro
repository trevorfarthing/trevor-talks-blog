---
/*
  Minimal homepage post list. Each row is date, title, and reading time.
  On devices with a mouse, hovering a row shows that post's cover image next to the cursor.
  Styles live in src/styles/modern.css so they survive Swup page transitions.
*/
import type { CollectionEntry } from 'astro:content';
import { formatDate, calculateReadingTime } from '@/utils/markdown';
import { optimizePostImagePath } from '@/utils/images';
import { siteConfig } from '@/config';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;

const rows = posts.map((post) => {
  const readingTime = calculateReadingTime(post.body || '');
  const image = typeof post.data.image === 'string' && post.data.image.trim() !== ''
    ? optimizePostImagePath(post.data.image, post.id, post.id)
    : null;

  return {
    id: post.id,
    title: post.data.title,
    date: post.data.date,
    readingText: readingTime.text || '1 min read',
    image,
    imageAlt: post.data.imageAlt || '',
  };
});
---

<div class="post-list" data-post-list>
  <!-- Preview images are stacked here and shown one at a time on hover -->
  <div class="post-list-preview" aria-hidden="true">
    {rows.map((row) => row.image && (
      <img src={row.image} alt="" data-preview-for={row.id} loading="lazy" decoding="async" />
    ))}
  </div>

  <ul class="post-list-rows">
    {rows.map((row) => (
      <li>
        <a class="post-list-row" href={`/posts/${row.id}`} data-preview-id={row.image ? row.id : undefined}>
          <time class="post-list-date" datetime={row.date.toISOString()}>{formatDate(row.date)}</time>
          <h3 class="post-list-title">{row.title}</h3>
          {siteConfig.postOptions.readingTime && (
            <span class="post-list-meta">{row.readingText}</span>
          )}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  /*
    One delegated listener on the document handles every post list.
    This keeps working after Swup swaps the page content, without re-binding.
  */
  const PREVIEW_OFFSET_X = 28;
  const PREVIEW_OFFSET_Y = 90;
  let activeImage: HTMLImageElement | null = null;

  const hidePreview = (list: Element | null) => {
    list?.querySelector('.post-list-preview')?.classList.remove('is-visible');
    activeImage?.classList.remove('is-active');
    activeImage = null;
  };

  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');

  document.addEventListener('pointermove', (event) => {
    if (!canHover.matches) {
      return;
    }
    const target = event.target as Element | null;
    const list = target?.closest('[data-post-list]') ?? null;
    if (!list) {
      if (activeImage) {
        hidePreview(activeImage.closest('[data-post-list]'));
      }
      return;
    }

    const preview = list.querySelector<HTMLElement>('.post-list-preview');
    const row = target?.closest<HTMLElement>('.post-list-row[data-preview-id]');
    if (!preview || !row) {
      hidePreview(list);
      return;
    }

    const image = preview.querySelector<HTMLImageElement>(`[data-preview-for="${CSS.escape(row.dataset.previewId ?? '')}"]`);
    if (image !== activeImage) {
      activeImage?.classList.remove('is-active');
      image?.classList.add('is-active');
      activeImage = image;
    }

    // Position relative to the list, and keep the preview inside its right edge
    const bounds = list.getBoundingClientRect();
    const maxX = bounds.width - preview.offsetWidth;
    const x = Math.min(event.clientX - bounds.left + PREVIEW_OFFSET_X, maxX);
    const y = event.clientY - bounds.top - PREVIEW_OFFSET_Y;
    preview.style.setProperty('--preview-x', `${Math.max(0, x)}px`);
    preview.style.setProperty('--preview-y', `${y}px`);
    preview.classList.add('is-visible');
  });

  // Hide the preview if the cursor leaves the browser window while over a row
  document.documentElement.addEventListener('mouseleave', () => {
    if (activeImage) {
      hidePreview(activeImage.closest('[data-post-list]'));
    }
  });
</script>
